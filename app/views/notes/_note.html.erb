<div id="<%= dom_id(note) %>" class="bg-white rounded-lg shadow p-6">
  <h2 class="text-xl font-semibold text-gray-800 mb-4"><%= note.title %></h2>
  <div class="prose max-w-none text-gray-700 mb-4"><%= note.content.to_s %></div>

  <div class="flex justify-between items-center">
    <%= link_to 'Edit', edit_note_path(note), class: 'text-blue-500 hover:underline', data: { turbo: "false" } %>
    <%= button_to 'Delete', note, method: :delete, form: { class: 'inline' }, data: { turbo_confirm: 'Are you sure?' }, class: 'text-red-500 hover:underline' %>
  </div>
</div>
