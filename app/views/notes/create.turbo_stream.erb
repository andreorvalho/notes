<%= turbo_stream.append 'notes', partial: 'notes/note', locals: { note: @note } %>
<%= turbo_stream.replace 'note_form', partial: 'notes/form', locals: { note: Note.new, form_local: true } %>
<%= turbo_stream.append 'flash-form', partial: 'shared/flash', locals: { message: 'Note was successfully created.', classes: "bg-green-100 text-green-700" } %>
