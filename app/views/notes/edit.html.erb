<div class="container mx-auto px-4 py-8 max-w-lg">
  <h1 class="text-2xl font-bold text-center mb-6"><%= action_name.capitalize %> Note</h1>

  <%= form_with model: @note, class: 'space-y-6', local: false do |form| %>
    <div>
      <%= form.label :title, class: 'block text-gray-700 font-medium' %>
      <%= form.text_field :title, class: 'mt-1 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500' %>
    </div>
    <div>
      <%= form.label :content, class: 'block text-gray-700 font-medium' %>
      <%= form.rich_text_area :content, class: 'mt-1 block w-full border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500' %>
    </div>
    <div class="text-center">
      <%= form.submit class: 'bg-blue-500 text-white py-2 px-4 rounded shadow hover:bg-blue-600' %>
    </div>
  <% end %>
</div>
