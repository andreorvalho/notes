<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-center mb-6">Notes</h1>



  <div class="flex flex-col md:flex-row bg-gray-100 rounded-lg shadow-md overflow-hidden">
    <!-- Column 1 -->
    <div class="w-full md:w-1/2 p-6 bg-white">
      <div id="flash-form"></div>
      <h2 class="text-xl font-semibold mb-4">Add a Note</h2>
      <%= render 'form', note: Note.new , form_local: true %>
    </div>

    <!-- Column 2 -->
    <div class="w-full md:w-1/2 p-6 bg-gray-50">
      <div id="flash-list"></div>
      <h2 class="text-xl font-semibold mb-4">Notes</h2>
      <div id="notes" class="grid gap-6 grid-cols-1 ">
        <%= turbo_frame_tag 'notes' do %>
          <%= render @notes %>
        <% end %>
      </div>
    </div>
  </div>
</div>
